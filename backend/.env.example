# ── 서버 ──────────────────────────────────
NODE_ENV=development
PORT=4000

# 프론트엔드 출처(쉼표로 여러 개). 배포 시 실제 도메인으로 교체하세요.
CORS_ORIGIN=http://localhost:4000,http://localhost:5173

# ── 데이터 소스 ───────────────────────────
# json  : backend/src/data/portfolio.json 사용 (기본값, DB 불필요)
# mongo : MongoDB 사용 (repositories/mongo/*.js 구현 필요)
DATA_SOURCE=json

# DATA_SOURCE 가 json 이 아닐 때만 사용됩니다.
DATABASE_URL=
DATABASE_NAME=portfolio

# ── 외부 API 연동 (선택) ──────────────────
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT_MS=8000
