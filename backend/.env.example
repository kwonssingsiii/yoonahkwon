# ── 서버 ──────────────────────────────────
NODE_ENV=development
PORT=4000

# 프론트엔드 출처(쉼표로 여러 개). 배포 시 실제 도메인으로 교체하세요.
CORS_ORIGIN=http://localhost:4000,http://localhost:5173

# ── 데이터 소스 ───────────────────────────
# supabase : Supabase 의 *_public 뷰에서 읽음 (기본값, 아래 SUPABASE_* 값 필요)
# json     : backend/src/data/portfolio.json 사용 (DB 없이 시험할 때만)
# mongo    : MongoDB 사용 (repositories/mongo/*.js 구현 필요)
DATA_SOURCE=supabase

# DATA_SOURCE=mongo 일 때만 사용됩니다.
DATABASE_URL=
DATABASE_NAME=portfolio

# ── 방문 예약 저장소 · Supabase 접속 정보 ─────
# supabase : Supabase reservations 테이블 (기본값)
# json     : 메모리 저장 (로컬 시험용, 재시작 시 사라짐)
RESERVATION_STORE=supabase
# Supabase 대시보드 → Project Settings → API Keys 에서 복사 (publishable 키만! secret 키 금지)
# DATA_SOURCE 나 RESERVATION_STORE 가 supabase 면 꼭 채워야 서버가 켜집니다.
SUPABASE_URL=https://프로젝트ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_여기에붙여넣기

# ── 외부 API 연동 (선택) ──────────────────
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT_MS=8000
